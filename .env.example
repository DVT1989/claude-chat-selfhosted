# Generated for you by ./setup.sh. Edit APP_URL / APP_PORT if needed.

# Application
APP_PORT=15980
APP_URL=http://localhost:15980

# Database
POSTGRES_USER=claudechat
POSTGRES_PASSWORD=change_me
POSTGRES_DB=claudechat

# Redis
REDIS_PASSWORD=change_me

# Security (openssl rand -hex 64 / -hex 32)
JWT_SECRET=change_me
ENCRYPTION_KEY=change_me
INTERNAL_API_KEY=change_me

# First login: user "admin" with this password (empty = random, printed in the backend log)
ADMIN_PASSWORD=

# Web push (optional): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# OneDrive connector (optional, Azure app registration)
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
